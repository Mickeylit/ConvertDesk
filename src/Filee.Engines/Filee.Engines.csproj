<!--
  Filee.Engines: IConverter implementations (one file per engine) and helpers to find external tools.
  Register new engines in EngineRegistry.cs.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Filee.Engines</RootNamespace>
    <!-- Opt-in only: ordinary upstream development and its full test suite retain every engine. -->
    <ConvertDeskDocumentsOnly Condition="'$(ConvertDeskDocumentsOnly)' == ''">false</ConvertDeskDocumentsOnly>
    <DefineConstants Condition="'$(ConvertDeskDocumentsOnly)' == 'true'">$(DefineConstants);CONVERTDESK_DOCUMENTS_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- These packages belong only to upstream formats outside ConvertDesk's document scope. -->
  <ItemGroup Condition="'$(ConvertDeskDocumentsOnly)' != 'true'">
    <PackageReference Include="Unhwp" />
    <PackageReference Include="ExcelNumberFormat" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="MimeKitLite" />
    <PackageReference Include="ACadSharp" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="MsgReader" />
    <PackageReference Include="SharpGLTF.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(ConvertDeskDocumentsOnly)' == 'true'">
    <!-- Keep the source tree and notices intact; only the product assembly is reduced. -->
    <Compile Remove="Cad/**/*.cs;Data/**/*.cs;Geo/**/*.cs;Models3D/**/*.cs;Email/**/*.cs;Ofd/**/*.cs;Heic/**/*.cs" />
    <Compile Remove="Media/FfmpegConverter.cs;Media/LivePhotoWriter.cs;Media/FrameSequenceWriter.cs" />
    <Compile Remove="Ebooks/**/*.cs" />
    <Compile Include="Ebooks/Book.cs" />
    <Compile Remove="Office/Sheets/**/*.cs" />
    <Compile Include="Office/Sheets/SpreadsheetPrintPlan.cs" />
    <Compile Remove="Office/SpreadsheetConverter.cs;Office/OoxmlConverter.cs;Hwp/UnhwpConverter.cs;Hwp/Hwpx/SheetDocument.cs;Pdf/PdfTablesConverter.cs" />
    <Compile Remove="Subtitles/**/*.cs" />
    <Compile Include="Subtitles/SubtitleEncoding.cs" />
    <Compile Remove="Archives/**/*.cs" />
    <Compile Include="Archives/SevenZip.cs;Archives/ArchiveSafety.cs;Archives/Crc32.cs" />
    <Compile Remove="Vector/VectorConverter.cs;Vector/SvgDxfWriter.cs;Vector/DstEmbroidery.cs;Vector/HpglPlot.cs;Vector/Tracing/**/*.cs" />
    <Compile Remove="Magick/MagickImageConverter.cs;Magick/ImageJoiner.cs;Fonts/FontConverter.cs;Icns/IcnsConverter.cs;Wic/WicImageConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filee" />
    <InternalsVisibleTo Include="Filee.Engines.Tests" />
    <InternalsVisibleTo Include="Filee.Documents.Tests" />
    <InternalsVisibleTo Include="Filee.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference HWPX (styles, page setup) from pypandoc-hwpx (MIT), see Hwp/Hwpx/HwpxWriter.cs. -->
    <EmbeddedResource Include="Hwp\Hwpx\blank.hwpx" LogicalName="Filee.Engines.Hwpx.blank.hwpx" />
    <!-- Pinned downloads of optional engines, also read by build/fetch-engines.ps1. -->
    <EmbeddedResource Include="Infrastructure\engines.json" LogicalName="Filee.Engines.engines.json" />
    <!-- Pinned Tesseract language data, downloaded when an OCR preset needs it (Ocr/OcrLanguages.cs). -->
    <EmbeddedResource Include="Infrastructure\ocr-languages.json" LogicalName="Filee.Engines.ocr-languages.json" />
  </ItemGroup>
</Project>
