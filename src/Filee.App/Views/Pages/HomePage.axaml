<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:app="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="MinHeight" Value="200" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.has-files">
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.format-picker">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ListBox.format-picker ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.format-picker ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="ListBox.format-picker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.small-link">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="20" MaxWidth="740" HorizontalAlignment="Stretch">
    <StackPanel Spacing="7">
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Workspace.Title}" />
      <TextBlock Classes="caption" Text="HTML / PDF / PPTX / DOCX / TXT" />
    </StackPanel>

    <StackPanel IsVisible="{Binding IsElevated}" Spacing="4">
      <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{DynamicResource home.elevated}" />
      <Button Classes="ghost small-link" HorizontalAlignment="Left" Content="{DynamicResource home.elevated_restart}"
              Command="{Binding RestartWithoutAdministratorRightsCommand}" />
      <TextBlock Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding ElevationRestartFailed}"
                 Text="{DynamicResource home.elevated_restart_failed}" />
    </StackPanel>

    <StackPanel Spacing="10">
      <Border x:Name="DropZone" Classes.has-files="{Binding Workspace.HasContent}" DragDrop.AllowDrop="True"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
              BorderThickness="1" CornerRadius="8">
        <Grid>
          <StackPanel IsVisible="{Binding !Workspace.HasContent}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Spacing="14">
            <PathIcon Width="28" Height="28" Data="{StaticResource Icon.Upload}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock FontSize="16" HorizontalAlignment="Center" Text="{Binding Workspace.DropTitle}" />
            <Button Click="OnChooseFiles" HorizontalAlignment="Center" Content="{Binding Workspace.AddFilesText}" />
          </StackPanel>
          <Grid IsVisible="{Binding Workspace.HasContent}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                VerticalAlignment="Center">
            <PathIcon Width="20" Height="20" Data="{StaticResource Icon.Upload}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding Workspace.ContinueAddingText}" />
            <Button Grid.Column="2" Click="OnChooseFiles" Content="{Binding Workspace.AddFilesText}" />
          </Grid>
        </Grid>
      </Border>
      <TextBlock IsVisible="{Binding Workspace.HasMessage}" Classes="caption danger"
                 TextWrapping="Wrap" Text="{Binding Workspace.Message}" />
      <Grid IsVisible="{Binding Workspace.HasFiles}" ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Workspace.FilesSummary}" />
        <Button Grid.Column="1" Classes="ghost small-link" Content="{Binding Workspace.ClearText}"
                Command="{Binding Workspace.ClearFilesCommand}" />
      </Grid>
      <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding Workspace.HasFiles}">
        <ItemsControl ItemsSource="{Binding Workspace.Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentInputViewModel">
              <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9" Margin="0,0,8,0">
                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="caption" FontSize="10" FontWeight="SemiBold" Text="{Binding Format}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Classes="caption" Classes.danger="{Binding IsBlocked}" TextWrapping="Wrap" Text="{Binding Status}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon ghost" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding RemoveText}" AutomationProperties.Name="{Binding RemoveText}">
                    <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="caption" Text="{Binding Workspace.TargetTitle}" />
      <ListBox Classes="format-picker" ItemsSource="{Binding Workspace.Targets}" SelectedItem="{Binding Workspace.SelectedTarget}"
               SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Workspace.TargetTitle}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentTargetViewModel">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Workspace.ShowsPptxHint}" Text="{Binding Workspace.PptxHint}" />
      <Grid IsVisible="{Binding Workspace.NeedsPackage}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Workspace.DependencyHint}" />
        <Button Grid.Column="1" Classes="ghost small-link" Content="{Binding Workspace.RefreshText}" Command="{Binding Workspace.RefreshCommand}" />
      </Grid>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"
                 Text="{Binding Workspace.OutputHint}" ToolTip.Tip="{Binding Workspace.LocalProcessingText}" />
      <Button Grid.Column="1" Classes="accent" MinWidth="138" MinHeight="40"
              HorizontalContentAlignment="Center" Content="{Binding Workspace.ConvertText}" Command="{Binding Workspace.ConvertCommand}" />
    </Grid>

    <ItemsControl IsVisible="{Binding Workspace.HasJobs}" ItemsSource="{Binding Workspace.Jobs}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="app:JobViewModel">
          <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Status}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost small-link" Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                  <Button Classes="ghost small-link" Content="{DynamicResource home.open_folder}" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" />
                </StackPanel>
              </Grid>
              <ProgressBar Classes="soft" Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsRunning}" />
              <SelectableTextBlock Classes="caption danger" TextWrapping="Wrap" Text="{Binding ErrorDetails}" IsVisible="{Binding HasErrors}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Notices}" IsVisible="{Binding HasNotices}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding MissingFontsText}" IsVisible="{Binding HasMissingFonts}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Expander IsVisible="{Binding !IsEmpty}" IsExpanded="False" Header="{DynamicResource home.recent}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBox Classes="search clearButton" Text="{Binding Search}" PlaceholderText="{DynamicResource common.search}" />
          <Button Grid.Column="1" Classes="ghost small-link" Content="{DynamicResource home.clear_history}" Command="{Binding ClearHistoryCommand}" />
        </Grid>
        <TextBlock Classes="caption" Text="{DynamicResource home.no_matches}" IsVisible="{Binding NoMatches}" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryItemViewModel">
              <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Time}" />
                  </Grid>
                  <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasOutputs}">
                    <Button Classes="ghost small-link" Margin="0,0,16,0" Command="{Binding OpenFileCommand}" IsVisible="{Binding CanOpen}"
                            Content="{DynamicResource home.open_file}" />
                    <Button Classes="ghost small-link" Margin="0,0,16,0" Command="{Binding OpenFolderCommand}" Content="{DynamicResource home.open_folder}" />
                    <Button Classes="ghost small-link" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                            Content="{DynamicResource home.undo}" ToolTip.Tip="{DynamicResource home.undo_hint}" />
                  </WrapPanel>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding UndoneText}" IsVisible="{Binding IsUndone}" />
                  <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{Binding UndoError}" IsVisible="{Binding HasUndoError}" />
                  <WrapPanel IsVisible="{Binding HasFailures}">
                    <Button Classes="ghost small-link" Command="{Binding ToggleFailuresCommand}" Content="{Binding FailureSummary}" Margin="0,0,16,0" />
                    <Button Classes="ghost small-link" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Content="{DynamicResource common.retry}" />
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding ShowFailures}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:FailureItem">
                        <StackPanel Spacing="3" Margin="0,4">
                          <SelectableTextBlock Classes="caption" Text="{Binding Name}" TextWrapping="Wrap" />
                          <SelectableTextBlock Classes="caption danger" Text="{Binding Reason}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>

    <Button Classes="ghost small-link" IsVisible="{Binding NeedsAccessibility}" HorizontalAlignment="Left"
            Content="{Binding Workspace.PermissionLinkText}" ToolTip.Tip="{Binding Workspace.PermissionOptionalText}"
            Command="{Binding OpenAccessibilityCommand}" />
  </StackPanel>
</UserControl>
