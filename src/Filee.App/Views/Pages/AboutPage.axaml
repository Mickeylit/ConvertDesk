<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Spacing="20">
    <TextBlock Classes="h1" Text="ConvertDesk" />
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Document conversion, thoughtfully simplified." />
        <TextBlock Classes="muted" Text="HTML · PDF · PPTX · DOCX · TXT" />
        <TextBlock Classes="muted" Text="{Binding Version}" />
        <TextBlock TextWrapping="Wrap" Text="ConvertDesk is an independent, modified application based on Filee by Myeonggu Kim and the Filee contributors. It retains their MIT license and third-party notices. ConvertDesk is not an official Filee release." />
        <Button Classes="ghost" HorizontalAlignment="Left" Click="OnOpenRepository" Content="Original Filee project and source (GitHub)" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Local processing" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Documents are processed on this computer. Additional document engines may need an initial download. Automatic application updates are disabled; this build will never replace itself with the upstream application." />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="MIT license · Original project" />
        <TextBlock Text="{Binding OriginalLicense}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" FlowDirection="LeftToRight" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
