<!-- Compact document tool: one workspace, with secondary preferences in a menu. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource app.name}"
        Icon="avares://Filee/Assets/Icons/convertdesk.ico"
        Width="820" Height="650" MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="26,13">
      <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding GoHomeCommand}" IsVisible="{Binding !IsHome}"
                  Content="{Binding BackText}" Padding="0,5,10,5" />
          <TextBlock Text="ConvertDesk" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionLabel" Text="{Binding VersionText}" Classes="caption" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding VersionText}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="{Binding SettingsText}" Padding="10,5" Command="{Binding ToggleSettingsCommand}" />
      </Grid>
      <WrapPanel IsVisible="{Binding SettingsOpen}" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Classes="ghost" Content="{DynamicResource nav.general}" Command="{Binding NavigatePageCommand}" CommandParameter="general" />
        <Button Classes="ghost" Content="{DynamicResource nav.engines}" Command="{Binding NavigatePageCommand}" CommandParameter="engines" />
        <Button Classes="ghost" Content="{DynamicResource nav.triggers}" Command="{Binding NavigatePageCommand}" CommandParameter="triggers" />
        <Button Classes="ghost" Content="{DynamicResource nav.theme}" Command="{Binding NavigatePageCommand}" CommandParameter="theme" />
        <Button Classes="ghost" Content="{DynamicResource nav.about}" Command="{Binding NavigatePageCommand}" CommandParameter="about" />
      </WrapPanel>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="30,24,30,24" MaxWidth="860" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
